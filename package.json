{
    "name": "snake-game",
    "version": "1.1.0",
    "description": "",
    "main": "script.js",
    "scripts": {
        "start": "http-server ./app/",
        "build": "tsc && npm run uglify",
        "dev": "concurrently -n \"cmp,srv\" -c \"blue,green\" -p \"[{name}]\" \"tsc -w\" \"npm start\"",
        "uglify": "for fl in $(find ./app -name \"*.js\"); do uglifyjs $fl -o $fl; done"
    },
    "keywords": [],
    "author": "sutaC",
    "license": "ISC",
    "dependencies": {
        "typescript": "^5.3.3",
        "uglify-js": "^3.18.0"
    },
    "devDependencies": {
        "concurrently": "^10.0.6",
        "http-server": "^14.1.1"
    }
}
